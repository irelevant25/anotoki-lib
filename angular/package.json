{
  "name": "anotoki-lib",
  "version": "0.0.0",
  "description": "The Angular workspace that builds @anotoki/lib (projects/lib); the package's own version is in projects/lib/package.json. projects/showcase is a development page showing every piece of the kit; it is never published.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "build": "ng build lib && node scripts/check-package.mjs",
    "watch": "ng build lib --watch --configuration development",
    "test": "ng test lib --watch=false",
    "showcase": "ng serve showcase",
    "build:showcase": "ng build showcase",
    "words": "node scripts/library-words.mjs",
    "format": "prettier --write \"projects/**/*.{ts,html,scss}\""
  },
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
